# Copy to .env (gitignored) and fill in. Never commit real keys.
LLM_PROVIDER=anthropic
MODEL_SUPERVISOR=
MODEL_SQL=
MODEL_JUDGE=
ANTHROPIC_API_KEY=

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=retailops-dev
# LANGSMITH_ENDPOINT=   # only for non-US regions

DUCKDB_PATH=data/retailops.duckdb
AUDIT_DB_PATH=data/audit.duckdb
VECTORSTORE_PATH=data/vectorstore
CHECKPOINT_DB_PATH=data/checkpoints.sqlite

MAX_STEPS=25
MAX_TOKENS_PER_RUN=60000
DAILY_BUDGET_USD=5
RATE_LIMIT_PER_MIN=20
APP_ENV=dev
